# ----------------------------------------------------------------------------
# WeCareForYou - MySQL/Sequelize server environment.
# Copy to ".env" and fill in real values.
# ----------------------------------------------------------------------------

# Server. Use 5000 to reuse the Angular default (run only ONE backend at a
# time on 5000), or 5001 to run alongside the MongoDB server.
PORT=5000
NODE_ENV=development

# --- MySQL connection ---
# Either set DATABASE_URL, or the individual DB_* parts below.
# DATABASE_URL=mysql://wecare:wecare@localhost:3306/wecareforyou
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wecareforyou
DB_USER=root
DB_PASSWORD=
# Auto create/update tables from models on boot (dev convenience).
DB_SYNC=true

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS - Angular dev origin
CLIENT_ORIGIN=http://localhost:4200

# Seed - demo account credentials
SEED_ADMIN_EMAIL=admin@wecareforyou.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_DOCTOR_EMAIL=doctor@wecareforyou.com
SEED_DOCTOR_PASSWORD=Doctor@123
SEED_PATIENT_EMAIL=patient@wecareforyou.com
SEED_PATIENT_PASSWORD=Patient@123
