# ----------------------------------------------------------------------------
# WeCareForYou - Server environment configuration
# Copy this file to ".env" and fill in the real values.
# ----------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (SRV URI).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wecareforyou?retryWrites=true&w=majority
# Make sure this machine's IP is allowlisted in Atlas (Network Access).
MONGO_URI=

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS - Angular dev server origin
CLIENT_ORIGIN=http://localhost:4200

# Seed - default demo account passwords (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@wecareforyou.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_DOCTOR_EMAIL=doctor@wecareforyou.com
SEED_DOCTOR_PASSWORD=Doctor@123
SEED_PATIENT_EMAIL=patient@wecareforyou.com
SEED_PATIENT_PASSWORD=Patient@123
