# ===== WeCareForYou — monorepo ignore rules =====

# Dependencies
node_modules/
**/node_modules/

# Environment / secrets — NEVER commit real .env files
.env
**/.env
.env.local
**/.env.local
!**/.env.example

# Build output
dist/
**/dist/
/client/.angular/
/client/out-tsc/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage / test artifacts
coverage/
**/coverage/

# Local tooling / agent config (not part of the project)
.claude/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
